{
  "expo": {
    "name": "Raphael Riders",
    "slug": "mercurio-passenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icono_sin_fondo-2-app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "mercurio-passenger",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.raphael.riders",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icono_sin_fondo-2-app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.raphael.riders",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
